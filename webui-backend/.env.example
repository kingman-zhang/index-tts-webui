# 配置模板：复制为 .env 后填入真实值（.env 不入库）

# ─── TTS 资源池：三类服务一种写法 ───
#
# 合成走「资源池」：池里有谁就用谁 —— 自建 tts-server 优先跑满，溢出的段交给云端；
# 多台自建之间按负载自动轮转。**加/减一台服务器 = 加/删一条资源**，不用改代码。
# 自建 tts-server、302.ai、SiliconFlow、autodl.art 在池里是同一种东西，
# 差别只在 provider 那一个字段，没有第二套变量名要记。
#
# 推荐配法（唯一真理源 = 一个 YAML 文件，改完**不用重启** backend）：
#   1) cp tts-resources.example.yaml data/config/tts-resources.yaml → 按需增删条目
#   2) 把下面这一行的注释去掉（Docker 里 /app/data 就是挂载卷 webui-backend/data）：
# TTS_RESOURCES_FILE=data/config/tts-resources.yaml
#
# 字段：id（唯一名，字母数字下划线短横线）/ provider（local|302ai|siliconflow|art）
#       / base_url（local 必填：那一台的地址；art 填服务根地址，其余可省走官方）
#       / api_key_env（云端必填：**环境变量名**，值仍写在下面「引擎 API Key」区）
#       / max_concurrency（可选，仅云端；缺省读 TTS_CONCURRENCY）
#       / weight（可选，调分流倾斜；缺省 1.0）
# 密钥**不写进配置文件** —— 里面只写环境变量名。
# ✅ 配置是 **YAML**：支持 `#` 注释 —— 想停用某条资源，把那一整条前面逐行加 `#` 即可
#    （2026-10-08 由 JSON 切换，就是为了这个；旧的 .json 文件 `mv` 改名成 .yaml 即可用，
#     内容不用动 —— JSON 是 YAML 的子集）。
# ⚠️ 扩展名必须是 .yaml / .yml；别用 Tab 缩进（YAML 只允许空格）。
#
# 也可以整段内联到下面这一行（改完必须重启 backend）：
# TTS_RESOURCES=[{id: gpu-a, provider: local, base_url: "http://host-a:8000"}]
#
# 两行都不配 ⇒ 退化成旧式：只用 TTS_URL 那一台自建 + 有 Key 的云平台。
#
# ── TTS_URL：一般**不用填** ──
# 未配置时自动取资源池里第一个 local 的地址。它的职责只有一个 ——
# **音色管理面**（预设音色上传、音色库增删改/试听、/api/tts/health 探针）
# 与旧播客端点；**合成不读它**（合成走资源池）。多台时它只作用于其中一台，
# 其余各台缺的音色由 voice_sync 在合成前自动补传。
# TTS_URL=http://localhost:8000
#
# 第三方 API 引擎默认并发（1-8，默认 3；local 资源恒为 1，不受此影响）
TTS_CONCURRENCY=3
# TTS_ENGINE_PREFERRED 已失效（2026-09-29）：资源池恒为「本地优先 + 云端公平分配」，
# 该变量不再决定任何顺序，填了只会打一条 warning —— 有这一行可直接删掉。
# 现在想调「用谁」：不想用的那台/那个账号，直接从资源列表里删掉或注释掉；
# 云端之间想倾斜分配比例，用该条资源的 weight。
# TTS_ENGINE_PREFERRED=indextts_302ai

# ─── 引擎 API Key（由资源池的 api_key_env 引用；缺哪个就跳过哪个资源）───
# 这些名字是配置文件里 api_key_env 的取值；下面的 *_BASE_URL 只在「旧式形态」
# （两行资源池配置都空着）下才被读取，YAML 里请写在该条目的 base_url 字段。
AUTODL_API_TOKEN=
INDEXTTS302_API_KEY=
INDEXTTS302_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=

# ─── 会员 / 积分（详见 MEMBERSHIP.md）───
# 1=合成提交必须登录（不扣费）；0=允许游客提交
MEMBER_REQUIRE_LOGIN=0
# 1=收费模式：登录才可提交、预扣积分、失败自动退款
MEMBER_ENFORCE=0
# 计费单价：每 1000 字扣多少积分（0=关闭按量扣费）。1 积分 = ¥0.01
MEMBER_POINTS_PER_1000_CHARS=50
# 单次合成最低收费（积分）。按实际字数线性计费并向上取整到 1 积分，
# 不足此值时按此值收；成本主要由合成段数决定，地板用于兜住短而碎的任务。
MEMBER_MIN_CHARGE=5
# 注册赠送 / 每日签到积分（0=关闭）
# 注册礼包 2026-10-05 由 100 调为 500（= ¥5 ≈ 1 万字）
MEMBER_REG_BONUS=500
MEMBER_CHECKIN_BONUS=20
# 积分商城：1=开放「模拟支付成功」端点（无真实支付通道时用于演示）。
# ⚠️ 接入真实支付后必须置 0 —— 开着等于任何登录用户都能给自己的订单免费入账。
MEMBER_MOCK_PAY=1
# 真实支付回调验签密钥（HMAC-SHA256，见 app/membership/pay.py）；
# 留空则 POST /api/pay/notify/* 一律 503（不提供"无密钥放行"的降级）。
PAY_NOTIFY_SECRET=
# 管理接口令牌（/api/admin/*）；留空则管理接口整体禁用
MEMBER_ADMIN_TOKEN=

# ─── 存储后端（账本 / 会话 / 内容 / 队列）───
# 完整方案：账本/会话/内容见 STORAGE_MIGRATION_PLAN.md，队列见 QUEUE_MIGRATION_PLAN.md。
# 四个后端**互相独立**，可以各自单独切换 —— 一次只动一处，出问题好定位、好回滚：
#   MEMBER_STORE   = file（默认）| mongo   账本：用户/订单/流水/优惠码/签到
#   SESSION_STORE  = file（默认）| redis   会话：登录 token（TTL 自动过期）
#   CONTENT_STORE  = file（默认）| mongo   内容：项目 / 术语表 / 收藏音色
#   QUEUE_STORE    = file（默认）| mongo   队列：合成任务（B1，仅持久化）
# ⚠️ 刻意**没有**「连不上就自动退回 file」这种兜底 —— 两后端的存储形态不同，静默切换
#    会让系统读到另一本（空的）账 / 另一套（空的）会话状态 / 另一份（空的内容，
#    表现为「项目、词条全不见了」）/ 另一队（空的任务，表现为「任务全没了」）。
#    配置错了就让它**启动即失败**（非法取值在 import 期就报错，不会悄悄降级）。
MEMBER_STORE=file
# 会话后端。file = data/members/sessions.json（与历史逐字节一致，回滚直接可用）；
# redis = 走下面的 REDIS_URL，resolve_token 由「读整份会话表」降为一次 GET。
SESSION_STORE=file
# 内容后端（二期 A/B）。file = data/projects/*.json 等（与历史逐字节一致）；
# mongo = 项目/术语表/收藏进 MongoDB（动因是**多实例部署**：文件版在 A 实例存的东西
# B 实例读不到）。切换前请先跑 tools/migrate_content.py 把已有文件灌进去。
CONTENT_STORE=file
# 队列后端（B1，2026-10-13）。file = data/queue/*.json（与历史逐字节一致）；
# mongo = 任务进 MongoDB 的 queue_tasks 集合。切换前先跑 tools/migrate_queue.py。
# 完整方案见 webui-backend/QUEUE_MIGRATION_PLAN.md。
QUEUE_STORE=file
# ⚠️ 本实例是否接管任务队列（1=默认接管；0=不接管：队列接口返回空、提交返回 503）。
# **多实例铁律（B2 上租约之前）**：只能在一台实例上开 1 —— 第二个实例会把对方
# `running` 的任务读进内存后改判 interrupted，用户再点删除就会把对方正在写的任务
# 从库里删掉。核对该看 /api/version 的 queue_worker_enabled，不是看这里。
QUEUE_WORKER_ENABLED=1
# MongoDB 连接串（凭据只放这里，别写进代码或文档）
MONGO_URL=
# 库名。与同实例上别的项目靠独立 database 隔离
MONGO_DB=podcast
# Redis 连接串，db 号在最后一段（例：redis://:口令@主机:30002/2）
REDIS_URL=
# ⚠️ 与别的项目**共用实例**时必须带前缀，否则 session:* 这类通用名会互踩
REDIS_KEY_PREFIX=podcast
# 连库超时（毫秒）。Mongo 默认 30s 会把接口挂死，这里快速失败
DB_TIMEOUT_MS=3000

# ─── 邮箱验证码注册（唯一注册方式；缺 SMTP 时相关接口返回 503）───
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=播客工坊

# ─── 文本前处理（合成链路上的六道关；默认值即为推荐值，一般不用改）───
# 顺序：术语表 → 人名分隔号 → 年份 → 时间 → 数值 → 号码
# 除最后一道「号码」外默认开启；改后需**重启 backend**（开关在模块导入时读取）
# 人名分隔号：把 `・`/`•`/`‧` 等 10 种中点变体收敛到同一形态。
# 只认 `·` 的本地前端会把这些变体原样塞进词表变 <unk> → 模型吐怪音。
NAME_PUNCT_NORMALIZE=1
NAME_PUNCT_TARGET=drop
# 年份读法：四位年份改逐位读（2011 年 → 二零一一年）。默认开启。
# 这条规则原先只在 tts-server（本地 GPU 引擎）链路上，云引擎会绕过它。
YEAR_NORMALIZE=1
# 时间读法：`12:30` → 十二点三十分。默认开启。
# 冒号在 TN 里可能退化成「比」（`12 : 30` 带空格时实测如此），所以自己转汉字。
# 原先只在本机 tts-server 链路上，2026-09-30 提到 backend 以覆盖云引擎。
TIME_NORMALIZE=1
# 数值读法：数值语境的阿拉伯数字换汉字（`230倍` → 二百三十倍）。默认开启。
# 与下面「号码」层**正交互补**：本层必须有单位/幅度词才命中，号码层恰好相反。
NUM_VALUE_NORMALIZE=1
# 数字读法（号码方向）：默认**关闭**。只补 TN 的缺口（≥7 位长号码被按数值读），
# 刻意不管 3 位短号（110/119/120，TN 已读对、最易误伤）。见 NUMBER_NORMALIZATION.md
NUM_NORMALIZE=0
# 号码里的 1 读「幺」（默认）还是「一」；yi=读一
NUM_ONE_READ=

# ─── 响度归一开关（PODCAST_NORM；模块导入时读取，改后必须重启 backend）───
#   gain（默认）= 逐段 ebur128 测量 → 固定增益 → alimiter 限幅
#                 （目标 -16 LUFS，峰值上限 -1.5 dBFS）
#   off         = 完全不做响度归一（off / none / 0 / false / no 等价）。
#                 用于对照实验与排障：关掉后音色之间、段落之间的响度会不齐，
#                 交付前记得调回来。要改目标响度 / 峰值上限，改
#                 app/audio_norm.py 顶部的 NORM_TARGET_LUFS / NORM_CEILING_DBFS
#                 （**只此一处** —— 两侧的重复常量已随 2026-10-09 的统一删除）。
#   ⚠️ 这是**唯一**的归一开关，一次覆盖全部四条路径：
#        「单人配音 / 双人播客」×「本地 GPU 壳 / 云 API(302.ai、autodl.art)」。
#        归一统一在 backend 的资源池门面执行（实现见 app/audio_norm.py）。
#   ⚠️ 本地 GPU 壳 tts-server 侧的归一**已退役**（默认不做，它只负责合成 → 变速
#      → 统一 24kHz）；该壳读的是它**自己进程环境**里的同名变量。要让它恢复自己
#      归一，得在启动它的环境里设 PODCAST_NORM=gain（正常不需要 —— 那样同一段
#      会被处理两遍）。它是否真没归一，看 /api/health 的 normalizes_loudness。
PODCAST_NORM=gain
