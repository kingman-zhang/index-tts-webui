# 配置模板：复制为 .env 后填入真实值（.env 不入库）

# ─── TTS 服务地址 ───
# 单台 tts-server：只填这一条（2.0 壳 = 8000，2.5 壳 = 8001）。
# 优先级（高→低）：--tts-url 命令行 > 真实环境变量 > 本文件 > 默认 localhost:8000。
# ⚠️ 启动器若传了 --tts-url，本文件会被**完全忽略**（详见 ENGINES.md「优先级陷阱」）。
TTS_URL=http://localhost:8000
# 多台 tts-server：用 TTS_RESOURCES（非空 JSON 列表）声明资源池，多个 local 条目会
# 「本地优先 + 按负载在本地之间轮转」地分流。配了它之后 TTS_URL **仍必须填**，
# 且要指向「管音色那台」—— 预设音色自动上传、音色库增删改、/api/tts/health 探针
# 都只作用于 TTS_URL 这一台（只有**合成**走资源池）。缺失的音色由 voice_sync
# 在各台服务器上按需自动补传，所以不做共享挂载也能跑。
# ⚠️ 多个 local 条目必须**每个都**写 shared_voice_paths=true，否则启动直接报错
#    （它现在只是形式声明，语义见 ENGINES.md「多本地音色与按需同步」）。
# TTS_RESOURCES=[{"id":"gpu-1","provider":"local","base_url":"http://host-a:8000","shared_voice_paths":true},{"id":"gpu-2","provider":"local","base_url":"http://host-b:8000","shared_voice_paths":true}]
# 也可把 JSON 写进文件（Docker 常用数据卷里的路径）：
# TTS_RESOURCES_FILE=/app/data/config/tts-resources.json
# 第三方 API 引擎并发数（1-8，默认 3；local 资源恒为 1，不受此影响）
TTS_CONCURRENCY=3
# TTS_ENGINE_PREFERRED 已弃用（2026-09-29）：资源池恒为「本地优先 + 云端公平分配」，
# 该变量不再决定任何顺序，填了只会打一条 warning。
# TTS_ENGINE_PREFERRED=indextts_302ai

# ─── 引擎 API Key（缺哪个跳过哪个）───
AUTODL_API_TOKEN=
INDEXTTS302_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=

# ─── 会员 / 积分（详见 MEMBERSHIP.md）───
# 1=合成提交必须登录（不扣费）；0=允许游客提交
MEMBER_REQUIRE_LOGIN=0
# 1=收费模式：登录才可提交、预扣积分、失败自动退款
MEMBER_ENFORCE=0
# 计费单价：每 1000 字扣多少积分（0=关闭按量扣费）。1 积分 = ¥0.01
MEMBER_POINTS_PER_1000_CHARS=50
# 单次合成最低收费（积分）。按实际字数线性计费并向上取整到 1 积分，
# 不足此值时按此值收；成本主要由合成段数决定，地板用于兜住短而碎的任务。
MEMBER_MIN_CHARGE=5
# 注册赠送 / 每日签到积分（0=关闭）
MEMBER_REG_BONUS=100
MEMBER_CHECKIN_BONUS=20
# 管理接口令牌（/api/admin/*）；留空则管理接口整体禁用
MEMBER_ADMIN_TOKEN=

# ─── 邮箱验证码注册（唯一注册方式；缺 SMTP 时相关接口返回 503）───
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=播客工坊

# ─── 文本前处理（合成链路上的六道关；默认值即为推荐值，一般不用改）───
# 顺序：术语表 → 人名分隔号 → 年份 → 时间 → 数值 → 号码
# 除最后一道「号码」外默认开启；改后需**重启 backend**（开关在模块导入时读取）
# 人名分隔号：把 `・`/`•`/`‧` 等 10 种中点变体收敛到同一形态。
# 只认 `·` 的本地前端会把这些变体原样塞进词表变 <unk> → 模型吐怪音。
NAME_PUNCT_NORMALIZE=1
NAME_PUNCT_TARGET=drop
# 年份读法：四位年份改逐位读（2011 年 → 二零一一年）。默认开启。
# 这条规则原先只在 tts-server（本地 GPU 引擎）链路上，云引擎会绕过它。
YEAR_NORMALIZE=1
# 时间读法：`12:30` → 十二点三十分。默认开启。
# 冒号在 TN 里可能退化成「比」（`12 : 30` 带空格时实测如此），所以自己转汉字。
# 原先只在本机 tts-server 链路上，2026-09-30 提到 backend 以覆盖云引擎。
TIME_NORMALIZE=1
# 数值读法：数值语境的阿拉伯数字换汉字（`230倍` → 二百三十倍）。默认开启。
# 与下面「号码」层**正交互补**：本层必须有单位/幅度词才命中，号码层恰好相反。
NUM_VALUE_NORMALIZE=1
# 数字读法（号码方向）：默认**关闭**。只补 TN 的缺口（≥7 位长号码被按数值读），
# 刻意不管 3 位短号（110/119/120，TN 已读对、最易误伤）。见 NUMBER_NORMALIZATION.md
NUM_NORMALIZE=0
# 号码里的 1 读「幺」（默认）还是「一」；yi=读一
NUM_ONE_READ=
