# 配置模板：复制为 .env 后填入真实值（.env 不入库）
#
# ⚠️ 新增配置项**一律追加到文件末尾**（不要插在中间）—— 这样与线上旧 .env 对比时
#    只看文件尾部就知道多了什么，不用在整份文件里找。

# ─── TTS 资源池：三类服务一种写法 ───
#
# 合成走「资源池」：池里有谁就用谁 —— 自建 tts-server 优先跑满，溢出的段交给云端；
# 多台自建之间按负载自动轮转。**加/减一台服务器 = 加/删一条资源**，不用改代码。
# 自建 tts-server、302.ai、SiliconFlow、autodl.art 在池里是同一种东西，
# 差别只在 provider 那一个字段，没有第二套变量名要记。
#
# 推荐配法（唯一真理源 = 一个 YAML 文件，改完**不用重启** backend）：
#   1) cp tts-resources.example.yaml data/config/tts-resources.yaml → 按需增删条目
#   2) 把下面这一行的注释去掉（Docker 里 /app/data 就是挂载卷 webui-backend/data）：
# TTS_RESOURCES_FILE=data/config/tts-resources.yaml
#
# 字段：id（唯一名，字母数字下划线短横线）/ provider（local|302ai|siliconflow|art）
#       / base_url（local 必填：那一台的地址；art 填服务根地址，其余可省走官方）
#       / api_key_env（云端必填：**环境变量名**，值仍写在下面「引擎 API Key」区）
#       / max_concurrency（可选，仅云端；缺省读 TTS_CONCURRENCY）
#       / weight（可选，调分流倾斜；缺省 1.0）
#       / enable（可选，布尔，缺省 true；写 false = 整条不参与调度，但保留在文件里，
#                 改回 true 即恢复。停用的条目不校验凭据，字段拼错仍会报错）
# 密钥**不写进配置文件** —— 里面只写环境变量名。
# ✅ 配置是 **YAML**：支持 `#` 注释 —— 想停用某条资源，加 `enable: false`，
#    或者把那一整条前面逐行加 `#`（两者等价，前者不用记地址）
#    （2026-10-08 由 JSON 切换，就是为了这个；旧的 .json 文件 `mv` 改名成 .yaml 即可用，
#     内容不用动 —— JSON 是 YAML 的子集）。
# ⚠️ 扩展名必须是 .yaml / .yml；别用 Tab 缩进（YAML 只允许空格）。
#
# 也可以整段内联到下面这一行（改完必须重启 backend）：
# TTS_RESOURCES=[{id: gpu-a, provider: local, base_url: "http://host-a:8000"}]
#
# 两行都不配 ⇒ 退化成旧式：只用 TTS_URL 那一台自建 + 有 Key 的云平台。
#
# ── TTS_URL：一般**不用填** ──
# 未配置时自动取资源池里第一个 local 的地址。它的职责只有一个 ——
# **音色管理面**（预设音色上传、音色库增删改/试听、/api/tts/health 探针）
# 与旧播客端点；**合成不读它**（合成走资源池）。多台时它只作用于其中一台，
# 其余各台缺的音色由 voice_sync 在合成前自动补传。
# TTS_URL=http://localhost:8000
#
# 第三方 API 引擎默认并发（1-8，默认 3；local 资源恒为 1，不受此影响）
TTS_CONCURRENCY=3
# TTS_ENGINE_PREFERRED 已失效（2026-09-29）：资源池恒为「本地优先 + 云端公平分配」，
# 该变量不再决定任何顺序，填了只会打一条 warning —— 有这一行可直接删掉。
# 现在想调「用谁」：不想用的那台/那个账号，直接从资源列表里删掉或注释掉；
# 云端之间想倾斜分配比例，用该条资源的 weight。
# TTS_ENGINE_PREFERRED=indextts_302ai

# ─── 引擎 API Key（由资源池的 api_key_env 引用；缺哪个就跳过哪个资源）───
# 这些名字是配置文件里 api_key_env 的取值；下面的 *_BASE_URL 只在「旧式形态」
# （两行资源池配置都空着）下才被读取，YAML 里请写在该条目的 base_url 字段。
AUTODL_API_TOKEN=
INDEXTTS302_API_KEY=
INDEXTTS302_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=
# Modelverse（Compshare）：⚠️ 这是 api.modelverse.cn 那套 Key（sk-…），
# **不是** cp.compshare.cn/audio/v1 的 sk-ml-… —— 两个入口互不相通，
# 拿错 Key 的表现是「配了却不生效 / 401 invalid api key」。详见 ENGINES.md
# 的《Modelverse（Compshare）接入要点》。
MODELVERSE_API_KEY=
MODELVERSE_BASE_URL=https://api.modelverse.cn

# ─── 会员 / 积分（详见 MEMBERSHIP.md）───
# 1=合成提交必须登录（不扣费）；0=允许游客提交
MEMBER_REQUIRE_LOGIN=0
# 1=收费模式：登录才可提交、预扣积分、失败自动退款
MEMBER_ENFORCE=0
# 计费单价：每 1000 字扣多少积分（0=关闭按量扣费）。1 积分 = ¥0.01
MEMBER_POINTS_PER_1000_CHARS=50
# 单次合成最低收费（积分）。按实际字数线性计费并向上取整到 1 积分，
# 不足此值时按此值收；成本主要由合成段数决定，地板用于兜住短而碎的任务。
MEMBER_MIN_CHARGE=5
# 注册赠送 / 每日签到积分（0=关闭）
# 注册礼包：100 → 500（2026-10-05）→ 200（2026-10-19，= ¥2 ≈ 4000 字）
MEMBER_REG_BONUS=200
MEMBER_CHECKIN_BONUS=20
# 积分商城：1=开放「模拟支付成功」端点（无真实支付通道时用于演示）。
# ⚠️ **默认 0**（2026-10-14 由 1 改为 0）—— 默认值取"安全的那一侧"：写漏这一项时
#    应当是「关」，而不是「任何登录用户都能调 mock-pay 端点给自己的订单免费入账」
#    （实测可复现）。纯演示环境（没有真实通道、要给人看购买流程）才显式写 1。
MEMBER_MOCK_PAY=0
# 「通用通道」（app/membership/pay_generic.py，通配 provider）的回调验签密钥（HMAC-SHA256）；
# 留空则该通道的回调一律 503（不提供"无密钥放行"的降级）。
# ⚠️ 这与具体业务通道的密钥（如下面的 MPAY_KEY）**不是一回事** —— 接了 mpay 就用不到它。
PAY_NOTIFY_SECRET=
# 管理接口令牌（/api/admin/*）；留空则管理接口整体禁用
MEMBER_ADMIN_TOKEN=

# ─── 存储后端（账本 / 会话 / 内容 / 队列）───
# 完整方案：账本/会话/内容见 STORAGE_MIGRATION_PLAN.md，队列见 QUEUE_MIGRATION_PLAN.md。
# 四个后端**互相独立**，可以各自单独切换 —— 一次只动一处，出问题好定位、好回滚：
#   MEMBER_STORE   = file | mongo（本模板默认）   账本：用户/订单/流水/优惠码/签到
#   SESSION_STORE  = file | redis（本模板默认）   会话：登录 token（TTL 自动过期）
#   CONTENT_STORE  = file | mongo（本模板默认）   内容：项目 / 术语表 / 收藏音色
#   QUEUE_STORE    = file | mongo（本模板默认）   队列：合成任务（B1，仅持久化）
# ⚠️ 本模板默认**已切库**（2026-10-15 拍板：全部走 mongo/redis）。复制本文件后、
#    启动前必须先做两件事，否则系统读到空库 ——「项目/词条全没了」「任务全没了」：
#    ① 填好下面的 MONGO_URL / REDIS_URL 并从容器网络确认连得通；
#    ② 跑 tools/init_indexes.py 建索引；已有 file 数据先灌库
#       （tools/migrate_content.py / tools/migrate_queue.py；账本无迁移工具＝空账本起步）。
# ⚠️ 刻意**没有**「连不上就自动退回 file」这种兜底 —— 两后端的存储形态不同，静默切换
#    会让系统读到另一本（空的）账 / 另一套（空的）会话状态 / 另一份（空的内容，
#    表现为「项目、词条全不见了」）/ 另一队（空的任务，表现为「任务全没了」）。
#    配置错了就让它**启动即失败**（非法取值在 import 期就报错，不会悄悄降级）。
MEMBER_STORE=mongo
# 会话后端。file = data/members/sessions.json（与历史逐字节一致，回滚直接可用）；
# redis = 走下面的 REDIS_URL，resolve_token 由「读整份会话表」降为一次 GET。
SESSION_STORE=redis
# 内容后端（二期 A/B）。file = data/projects/*.json 等（与历史逐字节一致）；
# mongo = 项目/术语表/收藏进 MongoDB（动因是**多实例部署**：文件版在 A 实例存的东西
# B 实例读不到）。切换前请先跑 tools/migrate_content.py 把已有文件灌进去。
CONTENT_STORE=mongo
# 队列后端（B1，2026-10-13）。file = data/queue/*.json（与历史逐字节一致）；
# mongo = 任务进 MongoDB 的 queue_tasks 集合。切换前先跑 tools/migrate_queue.py。
# 完整方案见 webui-backend/QUEUE_MIGRATION_PLAN.md。
QUEUE_STORE=mongo
# ⚠️ 本实例是否接管任务队列（1=默认接管；0=不接管：队列接口返回空、提交返回 503）。
# **多实例铁律（B2 上租约之前）**：只能在一台实例上开 1 —— 第二个实例会把对方
# `running` 的任务读进内存后改判 interrupted，用户再点删除就会把对方正在写的任务
# 从库里删掉。核对该看 /api/version 的 queue_worker_enabled，不是看这里。
QUEUE_WORKER_ENABLED=1
# MongoDB 连接串（凭据只放这里，别写进代码或文档）
MONGO_URL=
# 库名。与同实例上别的项目靠独立 database 隔离
MONGO_DB=podcast
# Redis 连接串，db 号在最后一段（例：redis://:口令@主机:30002/2）
REDIS_URL=
# ⚠️ 与别的项目**共用实例**时必须带前缀，否则 session:* 这类通用名会互踩
REDIS_KEY_PREFIX=podcast
# 连库超时（毫秒）。Mongo 默认 30s 会把接口挂死，这里快速失败
DB_TIMEOUT_MS=3000

# ─── 邮箱验证码注册（唯一注册方式；缺 SMTP 时相关接口返回 503）───
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=播客工坊

# ─── 文本前处理（合成链路上的七道关；默认值即为推荐值，一般不用改）───
# 顺序：术语表 → 人名分隔号 → 年份 → 时间 → 区间 → 数值 → 号码
# 除最后一道「号码」外默认开启；改后需**重启 backend**（开关在模块导入时读取）
# 人名分隔号：把 `・`/`•`/`‧` 等 10 种中点变体收敛到同一形态。
# 只认 `·` 的本地前端会把这些变体原样塞进词表变 <unk> → 模型吐怪音。
NAME_PUNCT_NORMALIZE=1
NAME_PUNCT_TARGET=drop
# 年份读法：四位年份改逐位读（2011 年 → 二零一一年）。默认开启。
# 这条规则原先只在 tts-server（本地 GPU 引擎）链路上，云引擎会绕过它。
YEAR_NORMALIZE=1
# 时间读法：`12:30` → 十二点三十分。默认开启。
# 冒号在 TN 里可能退化成「比」（`12 : 30` 带空格时实测如此），所以自己转汉字。
# 原先只在本机 tts-server 链路上，2026-09-30 提到 backend 以覆盖云引擎。
TIME_NORMALIZE=1
# 区间读法：`10~15岁` → 十到十五岁（波浪号统一成「到」）。默认开启。
# 波浪号在 TN 手里经常整个丢掉（`10 ~15 岁` 实测读成「十到一五岁」），
# 云引擎的 TN 又控制不了 ⇒ 自己转汉字。年份区间仍由上一道「年份」处理，本层不碰。
RANGE_NORMALIZE=1
# 数值读法：数值语境的阿拉伯数字换汉字（`230倍` → 二百三十倍）。默认开启。
# 与下面「号码」层**正交互补**：本层必须有单位/幅度词才命中，号码层恰好相反。
NUM_VALUE_NORMALIZE=1
# 数字读法（号码方向）：默认**关闭**。只补 TN 的缺口（≥7 位长号码被按数值读），
# 刻意不管 3 位短号（110/119/120，TN 已读对、最易误伤）。见 NUMBER_NORMALIZATION.md
NUM_NORMALIZE=0
# 号码里的 1 读「幺」（默认）还是「一」；yi=读一
NUM_ONE_READ=

# ─── 响度归一开关（PODCAST_NORM；模块导入时读取，改后必须重启 backend）───
#   gain（默认）= 逐段 ebur128 测量 → 固定增益 → alimiter 限幅
#                 （目标 -16 LUFS，峰值上限 -1.5 dBFS）
#   off         = 完全不做响度归一（off / none / 0 / false / no 等价）。
#                 用于对照实验与排障：关掉后音色之间、段落之间的响度会不齐，
#                 交付前记得调回来。要改目标响度 / 峰值上限，改
#                 app/audio_norm.py 顶部的 NORM_TARGET_LUFS / NORM_CEILING_DBFS
#                 （**只此一处** —— 两侧的重复常量已随 2026-10-09 的统一删除）。
#   ⚠️ 这是**唯一**的归一开关，一次覆盖全部四条路径：
#        「单人配音 / 双人播客」×「本地 GPU 壳 / 云 API(302.ai、autodl.art)」。
#        归一统一在 backend 的资源池门面执行（实现见 app/audio_norm.py）。
#   ⚠️ 本地 GPU 壳 tts-server 侧的归一**已退役**（默认不做，它只负责合成 → 变速
#      → 统一 24kHz）；该壳读的是它**自己进程环境**里的同名变量。要让它恢复自己
#      归一，得在启动它的环境里设 PODCAST_NORM=gain（正常不需要 —— 那样同一段
#      会被处理两遍）。它是否真没归一，看 /api/health 的 normalizes_loudness。
PODCAST_NORM=gain

# ═══════════════════════════════════════════════════════════
# 真实支付通道（积分商城购买）—— 2026-10-14
#
# 设计：**通道可插拔**。每条通道是一个独立模块（app/membership/pay_*.py）：
# 签名算法、回调载体（GET/POST）、应答体（纯文本/JSON）、金额策略全部在通道内声明。
# 加 / 换通道 = 加一个模块 + 改下面的 PAY_PROVIDER，`service` / `routes` 不用动。
# ⇒ mpay（个人收款监听，**不是标准方案**）与将来接的标准支付**互不耦合**。
#
# ⚠️ 本段**刻意放在文件末尾**：新配置一律追加到末尾，方便与新环境的 .env 逐段对比。
# ═══════════════════════════════════════════════════════════

# 当前生效的通道 id。留空 = 未接真实支付（回调 503、商城只能模拟支付）。
# 可选值：mpay   （已注册通道列表见 GET /api/version 的 membership.pay.known）
PAY_PROVIDER=
# 我们的**公网根地址**：回调地址 = {它}/api/pay/notify/{通道id}
#   ⇒ mpay 场景即 https://media.lizigege.com/api/pay/notify/mpay
#   ⚠️ 这里**只填根**（如 https://media.lizigege.com），**不要**把上面那串完整回调地址抄进来 ——
#      抄进来会拼成 .../notify/mpay/api/pay/notify/mpay，而 mpay **不校验 notify_url、照样返回成功**，
#      表现成「二维码能出、用户付了钱、积分永远不动」（静默失败，最难查）。
# ⚠️ 支付平台必须能访问到它（要填进支付平台后台），否则回调收不到。
PAY_PUBLIC_BASE_URL=
# 付款完成后跳回前端的地址（下发给支付平台的 return_url）。
PAY_RETURN_URL=
# 回调金额校验策略的**全局覆盖** —— **正常就该留空**（留空 = 按各通道自己声明的默认值）：
#   mpay 通道声明 ge（个人收款金额可能被微调）｜标准支付通道声明 strict
#   strict = 必须与订单金额完全相等 | ge = 不低于订单金额 | off = 不校验
# ⚠️ 填了就**对所有通道**生效（例：填 ge 会让将来接的微信官方也被放宽成「不低于」），
#    只在排查时临时填，用完恢复留空。2026-10-14 已实测：留空时 mpay 仍走 ge。
PAY_AMOUNT_CHECK=

# ── 通道：mpay_v2（码支付，ePay V1 / MD5）—— PAY_PROVIDER=mpay 时必填 ──
# pid 与密钥在 mpay 商户后台 → API 信息 里拿；对接方案见 PAY_MPAY_PLAN.md。
MPAY_BASE_URL=https://mpay.lizigege.com
# ⚠️ MPAY_PID 必须是**纯数字**（ePay V1 契约标注为 Int，示例 1001）。
#    填成商户编号（形如 M20261014120400214497）会被 mpay 直接拒：
#    {"code":0,"msg":"商户ID 必须是整数。"}
MPAY_PID=
MPAY_KEY=
# 收款方式：wxpay（微信个人收款监听）/ alipay / qqpay
MPAY_TYPE=wxpay
#
# ── 金额档 ↔ mpay 收款通道是怎么绑上的（**只靠金额，没有别的绑定物**）──
# V1 的 mapi.php **没有**指定通道的参数（V2 才有 channel_id），所以关联全靠 money：
#
#   套餐 packs.py: price_fen  →  订单快照 amount_fen  →  money = "%.2f" 元
#      p1000 10.00 │ p3200 30.00 │ p5750 50.00 │ p12500 100.00
#   ⇒ mpay 在自己的通道里挑「min ≤ money ≤ max」的那一条，把 out_trade_no 挂上去。
#
# ⚠️ 因此**改套餐价必须同步在 mpay 后台加/改通道**，否则用户一点「购买」就报：
#    「未找到可用支付通道：金额不在通道范围内（最小 X，最大 Y）；…」（逐条枚举全部通道）
#    ⇒ 刻意**不加代码守卫**：通道范围是平台侧配置、随时可变，硬编码进代码只会多一处漂移源。
# ⚠️ mpay 侧请保持**固定金额**（min == max）：若两条通道的范围重叠，命中哪条**未定义**。
# ⚠️ MPAY_TYPE 与通道所属支付方式不一致（如传 wxpay 而通道挂在 alipay 下）同样会「未找到可用通道」。
#
# ✅ 回调入账**不依赖金额**：用 out_trade_no 找回订单、按订单快照发积分，money 只做 ge 校验
#    ⇒ 金额档之间**不会串档**，回调金额被微调也不影响。
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 支付码有效期（**新增项一律追加在此，便于与环境对比**）—— 2026-10-15
#
# 「出码复用窗口」与前端显示的「请在 N 分钟内完成支付」**都由它派生**
#   （复用窗口 = 本值 − 60 秒余量；三者同源，不再各处写死）。
#
# ⚠️ 必须与支付平台那条通道的「识别有效期」设成**同一个值**：
#      mpay 后台 → 该通道配置 → 「识别有效期(秒)」（默认 300，上限 1800）。
#    平台只在有效期内为订单保留匹配资格 —— 我们若比它长，用户就会在
#    「平台已不认这张码」的时间段里被复用旧码 ⇒ 付了钱、平台匹配不到订单
#    = **必然漏单**（2026-10-15 实测踩到：界面写 30 分钟、mpay 只认 5 分钟）。
#    改一边必须同时改另一边（上线清单 B 段已把这两步并列）。
#
# 取值：300 = 5 分钟（2026-10-15 用户拍板统一 5 分钟）。不填则吃代码默认 300。
# 它同时决定三件事，所以三处永远同源、不会各说各话：
#   ① 前端「请在 N 分钟内完成支付」② 出码复用窗口（本值 − 60 秒）
#   ③ 订单多久之后被判为 expired（积分商城「最近订单」里不能再点「去支付」）
PAY_CHARGE_VALID_SECONDS=300
# ═══════════════════════════════════════════════════════════

# ─── 单人配音换行后的行间静音（2026-10-20）──────────────────────
# 画布里每按一次回车 = 一个独立合成段，段与段之间插入本时长的静音（毫秒）。
# 与行内 [pause:N] **叠加**（例：行末 [pause:1] + 本值 200 ⇒ 1.2 秒），
# 叠加后仍受单段静音上限 10 秒钳制；最后一行不加（避免成品尾部挂静音）。
# 行级 silence_after_ms 显式给出时以它为准（含显式 0 = 这行后面不要静音）。
#
# 刻意与播客的 PODCAST_SILENCE_BETWEEN_MS（默认 250）分开：
# 单人只有一个说话人，两条路径各调各的，改一边不会悄悄改另一边。
# ⚠️ 模块导入时读取 ⇒ 改后必须重启 backend；设 0 = 关闭（回到硬拼接）。
MONO_SILENCE_BETWEEN_MS=200
